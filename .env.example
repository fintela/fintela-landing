# ═══ fintela-landing — env template ═══
#
# DO NOT copy this by hand. `./setup_worktree.sh` writes the real files with this
# worktree's OWN ports, between generated markers:
#
#   .env.local              WEB_PORT, WEB_PREVIEW_PORT  (read by vite.config.ts in
#                           every mode; not VITE_-prefixed, so never in the bundle)
#   .env.development.local  VITE_FINTELA_API            (development mode ONLY —
#                           `vite build` never reads it)
#
# Everything outside the markers survives a re-render. deploy.sh's two variables
# go in the tail of .env.local:
#
#   S3_BUCKET=…
#   CLOUDFRONT_DISTRIBUTION=…

# ── Ports (slot 0 shown; yours come from infra/local/lib/ports.map) ──
WEB_PORT=11000
WEB_PREVIEW_PORT=11001

# ── Public origin of the site (build-time) ──
# Canonical URLs, og:url, JSON-LD @ids, the sitemaps and the feed are all
# written against it. Unset means https://fintela.io; set it for a preview
# build so a staging bucket never claims to be production. No trailing slash.
VITE_SITE_URL=

# ── Search Console verification (build-time, optional) ──
# The token from Search Console's "HTML tag" method. When set, vite.config.ts
# injects <meta name="google-site-verification"> into every document.
VITE_GOOGLE_SITE_VERIFICATION=

# ── Where the contact form POSTs ──
# Unset in a production build the code falls back to the real backend. In
# development it is a product worktree's backend, resolved by setup_worktree.sh
# from ~/.fintela/worktrees/<name>.env (`--product <name>`, default main), or an
# explicit `--api <url>`. Unset in development means the form fails visibly on
# submit — deliberately, so a local run cannot file a real request.
VITE_FINTELA_API=
