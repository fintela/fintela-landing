{
  "Name": "fintela-landing-origin-cache-control",
  "Comment": "fintela.io: TTL from each object's Cache-Control, nothing else in the key. Source: fintela-landing infra/cloudfront/",
  "MinTTL": 0,
  "DefaultTTL": 0,
  "MaxTTL": 31536000,
  "ParametersInCacheKeyAndForwardedToOrigin": {
    "EnableAcceptEncodingGzip": true,
    "EnableAcceptEncodingBrotli": true,
    "HeadersConfig": {
      "HeaderBehavior": "none"
    },
    "CookiesConfig": {
      "CookieBehavior": "none"
    },
    "QueryStringsConfig": {
      "QueryStringBehavior": "none"
    }
  }
}
